# Sentinel web app: static build served by nginx, which also proxies /api to the API.
FROM node:24-alpine AS build
WORKDIR /repo
COPY .certs/ /tmp/certs/
RUN cat /etc/ssl/certs/ca-certificates.crt /tmp/certs/*.pem > /tmp/ca-bundle.crt 2>/dev/null || cp /etc/ssl/certs/ca-certificates.crt /tmp/ca-bundle.crt
ENV NODE_EXTRA_CA_CERTS=/tmp/ca-bundle.crt
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @sentinel/web...
RUN pnpm --filter @sentinel/web build

FROM nginx:1.27-alpine AS runner
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
