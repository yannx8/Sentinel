// Sentinel data model. Rules and invariants: docs/PRD.md sections 6 and 7.
// Every tenant table carries organizationId and composite foreign keys keep
// child rows in their parent's organization (I1). Constraints Prisma cannot
// express live in prisma/sql/invariants.sql and are part of the baseline.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts (CLI) and src/lib/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum Plan {
  TRIAL
  STARTER
  BUSINESS
}

enum Industry {
  FACILITIES
  PROPERTY
  MANUFACTURING
  RETAIL
  HEALTHCARE
  EDUCATION
  HOSPITALITY
  LOGISTICS
  PUBLIC_SECTOR
  OTHER
}

enum SizeBand {
  XS
  S
  M
  L
  XL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserTokenKind {
  PASSWORD_RESET
}

enum MembershipRole {
  SUPERVISOR
  REPORTER
  INTERVENANT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum Availability {
  AVAILABLE
  BUSY
  OFF
}

enum IncidentStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REASSIGNMENT_REQUESTED
  DECLINED
  SUPERSEDED
  COMPLETED
}

enum ProgressType {
  ON_SITE
  BLOCKED
  UPDATE
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum DismissReason {
  DUPLICATE
  NOT_AN_INCIDENT
  NO_ACTION_NEEDED
}

enum ReassignmentReason {
  CANNOT_ACCESS
  WRONG_SPECIALTY
  UNAVAILABLE
  OTHER
}

enum AttachmentKind {
  REPORT
  EVIDENCE
  PROGRESS
}

enum AuditEventType {
  INCIDENT_CREATED
  TRIAGED
  ASSIGNED
  UNASSIGNED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_DECLINED
  REASSIGNMENT_REQUESTED
  REASSIGNMENT_REJECTED
  PROGRESS_POSTED
  RESOLVED
  SENT_BACK
  CLOSED
  DISMISSED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  MEMBER_INVITED
  INVITATION_REVOKED
  MEMBER_JOINED
  MEMBER_UPDATED
  MEMBER_SUSPENDED
  MEMBER_REACTIVATED
  MEMBER_REVOKED
  SITE_CREATED
  SITE_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  SPECIALTY_CREATED
  ORG_UPDATED
}

enum NotificationType {
  INCIDENT_CREATED
  ASSIGNED
  ASSIGNED_REPORTER
  ACCEPTED
  DECLINED
  REASSIGNMENT_REQUESTED
  REASSIGNMENT_REJECTED
  UNASSIGNED
  PROGRESS_POSTED
  RESOLVED
  SENT_BACK
  CLOSED
  COMMENT_ADDED
  INVITATION_ACCEPTED
}

enum PlatformEventType {
  ORG_SUSPENDED
  ORG_REACTIVATED
  PLAN_CHANGED
  REGISTRATION_RESENT
}

// Identity

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  passwordHash     String?
  firstName        String
  lastName         String
  phone            String?
  locale           String     @default("en")
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions      Session[]
  tokens        UserToken[]
  memberships   Membership[]
  platformAdmin PlatformAdmin?
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  userAgent     String?
  ip            String?
  mfaVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  kind      UserTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Registration waits here until the email is verified. Nothing is created in tenant tables before.
model OrganizationRegistration {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  companyName    String
  contactName    String
  payload        Json
  tokenHash      String    @unique
  expiresAt      DateTime
  verifiedAt     DateTime?
  organizationId String?   @db.Uuid
  createdAt      DateTime  @default(now())

  @@index([email])
}

// Tenancy

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  slug                   String             @unique
  legalName              String
  displayName            String
  registrationNumber     String?
  industry               Industry
  sizeBand               SizeBand
  country                String
  city                   String?
  timezone               String
  defaultLocale          String
  website                String?
  billingEmail           String
  status                 OrganizationStatus @default(ACTIVE)
  plan                   Plan               @default(TRIAL)
  trialEndsAt            DateTime?
  requireResolutionPhoto Boolean            @default(false)
  showReporterPhone      Boolean            @default(false)
  termsVersion           String
  termsAcceptedAt        DateTime
  termsAcceptedByUserId  String             @db.Uuid
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  memberships   Membership[]
  sites         Site[]
  specialties   Specialty[]
  categories    IncidentCategory[]
  incidents     Incident[]
  assignments   Assignment[]
  progress      ProgressUpdate[]
  comments      Comment[]
  attachments   Attachment[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]
  notifications Notification[]
  savedViews    SavedView[]
  counters      OrganizationCounter[]
  platformAudit PlatformAuditEvent[]
}

model Membership {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  userId                String           @db.Uuid
  role                  MembershipRole
  isOwner               Boolean          @default(false)
  status                MembershipStatus @default(ACTIVE)
  invitedByMembershipId String?          @db.Uuid
  joinedAt              DateTime         @default(now())
  statusChangedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    Membership?  @relation("InvitedBy", fields: [invitedByMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  invited      Membership[] @relation("InvitedBy")

  employeeProfile    EmployeeProfile?
  intervenantProfile IntervenantProfile?
  specialties        IntervenantSpecialty[]
  siteAccesses       SiteAccess[]

  reportedIncidents Incident[]       @relation("Reporter")
  createdIncidents  Incident[]       @relation("CreatedBy")
  assignments       Assignment[]     @relation("Assignee")
  assignmentsGiven  Assignment[]     @relation("Assigner")
  progressUpdates   ProgressUpdate[]
  comments          Comment[]
  attachments       Attachment[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  savedViews        SavedView[]
  invitationsSent   Invitation[]

  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@index([userId])
}

model EmployeeProfile {
  membershipId   String  @id @db.Uuid
  organizationId String  @db.Uuid
  employeeCode   String?
  jobTitle       String?
  department     String?
  homeSiteId     String? @db.Uuid

  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  homeSite   Site?      @relation(fields: [homeSiteId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([membershipId, organizationId])
  @@unique([organizationId, employeeCode])
}

model IntervenantProfile {
  membershipId   String       @id @db.Uuid
  organizationId String       @db.Uuid
  companyName    String?
  availability   Availability @default(AVAILABLE)

  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([membershipId, organizationId])
}

model Specialty {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervenants IntervenantSpecialty[]
  categories   IncidentCategory[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model IntervenantSpecialty {
  membershipId   String @db.Uuid
  specialtyId    String @db.Uuid
  organizationId String @db.Uuid

  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  specialty  Specialty  @relation(fields: [specialtyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([membershipId, specialtyId])
}

model Site {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  address        String?
  city           String?
  contactName    String?
  contactPhone   String?
  latitude       Float?
  longitude      Float?
  landmark       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accesses     SiteAccess[]
  incidents    Incident[]
  employees    EmployeeProfile[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
}

// An intervenant may be assigned only on sites they have access to (I10).
model SiteAccess {
  membershipId   String   @db.Uuid
  siteId         String   @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  site       Site       @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([membershipId, siteId])
  @@index([siteId])
}

model Invitation {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  email                 String
  firstName             String
  lastName              String
  role                  MembershipRole
  profile               Json
  tokenHash             String         @unique
  invitedByMembershipId String         @db.Uuid
  createdAt             DateTime       @default(now())
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Membership   @relation(fields: [invitedByMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, email])
}

// Operations

model IncidentCategory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  defaultPriority Priority
  specialtyId     String?  @db.Uuid
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  specialty         Specialty?   @relation(fields: [specialtyId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  incidents         Incident[]   @relation("Category")
  reportedIncidents Incident[]   @relation("ReportedCategory")

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model Incident {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  reference             String
  siteId                String         @db.Uuid
  reporterMembershipId  String         @db.Uuid
  createdByMembershipId String         @db.Uuid
  // Original report, immutable after submission (I5).
  title                 String
  description           String         @default("")
  reportedCategoryId    String         @db.Uuid
  reportedPriority      Priority
  locationDetail        String?
  latitude              Float?
  longitude             Float?
  // Triage, written through audited events. Starts as the reported priority.
  categoryId            String         @db.Uuid
  priority              Priority
  status                IncidentStatus @default(NEW)
  version               Int            @default(1)
  declinedAt            DateTime?
  sentBackAt            DateTime?
  resolutionNote        String?
  dismissReason         DismissReason?
  dismissNote           String?
  createdAt             DateTime       @default(now())
  triagedAt             DateTime?
  firstAssignedAt       DateTime?
  startedAt             DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  updatedAt             DateTime       @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site             Site             @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  reporter         Membership       @relation("Reporter", fields: [reporterMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  createdBy        Membership       @relation("CreatedBy", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  category         IncidentCategory @relation("Category", fields: [categoryId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  reportedCategory IncidentCategory @relation("ReportedCategory", fields: [reportedCategoryId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)

  assignments     Assignment[]
  progressUpdates ProgressUpdate[]
  comments        Comment[]
  attachments     Attachment[]
  auditEvents     AuditEvent[]
  notifications   Notification[]

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@index([organizationId, status, priority])
  @@index([organizationId, createdAt])
  @@index([organizationId, siteId])
  @@index([organizationId, categoryId])
  @@index([organizationId, reporterMembershipId])
}

model Assignment {
  id                      String              @id @default(uuid()) @db.Uuid
  organizationId          String              @db.Uuid
  incidentId              String              @db.Uuid
  intervenantMembershipId String              @db.Uuid
  assignedByMembershipId  String              @db.Uuid
  status                  AssignmentStatus    @default(PENDING_ACCEPTANCE)
  note                    String?
  declineReason           String?
  reassignmentReason      ReassignmentReason?
  reassignmentNote        String?
  reassignmentRequestedAt DateTime?
  assignedAt              DateTime            @default(now())
  respondedAt             DateTime?
  endedAt                 DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  intervenant  Membership   @relation("Assignee", fields: [intervenantMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  assignedBy   Membership   @relation("Assigner", fields: [assignedByMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)

  progressUpdates ProgressUpdate[]

  @@unique([id, organizationId])
  @@index([intervenantMembershipId, status])
  @@index([incidentId, assignedAt])
}

model ProgressUpdate {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  incidentId         String       @db.Uuid
  assignmentId       String       @db.Uuid
  authorMembershipId String       @db.Uuid
  type               ProgressType
  note               String
  // Arrival fix, set with ON_SITE when the intervenant shared a position.
  latitude           Float?
  longitude          Float?
  accuracyM          Int?
  distanceM          Int?
  createdAt          DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignment   Assignment   @relation(fields: [assignmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author       Membership   @relation(fields: [authorMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
}

model Comment {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  incidentId         String            @db.Uuid
  authorMembershipId String            @db.Uuid
  visibility         CommentVisibility
  body               String
  createdAt          DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author       Membership   @relation(fields: [authorMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
}

model Attachment {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @db.Uuid
  incidentId             String         @db.Uuid
  uploadedByMembershipId String         @db.Uuid
  kind                   AttachmentKind
  fileName               String
  mimeType               String
  sizeBytes              Int
  storageKey             String         @unique
  createdAt              DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  uploadedBy   Membership   @relation(fields: [uploadedByMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
}

// Cross-cutting

// Append-only (I7, trigger in prisma/sql/invariants.sql). Also the source of each incident's Thread.
model AuditEvent {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  incidentId        String?        @db.Uuid
  actorMembershipId String?        @db.Uuid
  actorUserId       String?        @db.Uuid
  type              AuditEventType
  payload           Json           @default("{}")
  createdAt         DateTime       @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident        Incident?    @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  actorMembership Membership?  @relation(fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, incidentId, createdAt])
  @@index([organizationId, createdAt])
}

/// A supervisor's named inbox filter. params holds a subset of the inbox search params (validated in the API).
model SavedView {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  membershipId   String   @db.Uuid
  name           String
  params         Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([membershipId, name])
}

model Notification {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  recipientMembershipId String           @db.Uuid
  type                  NotificationType
  incidentId            String?          @db.Uuid
  actorName             String?
  dedupeKey             String
  readAt                DateTime?
  createdAt             DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    Membership   @relation(fields: [recipientMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  incident     Incident?    @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipientMembershipId, dedupeKey])
  @@index([recipientMembershipId, readAt, createdAt])
}

model OrganizationCounter {
  organizationId String @db.Uuid
  name           String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, name])
}

// Replayed responses for retried creates and transitions, kept 24 hours.
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  scope        String
  key          String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([userId, scope, key])
  @@index([createdAt])
}

// Platform

model PlatformAdmin {
  userId     String   @id @db.Uuid
  totpSecret String
  createdAt  DateTime @default(now())

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  events PlatformAuditEvent[]
}

model PlatformAuditEvent {
  id             String            @id @default(uuid()) @db.Uuid
  adminUserId    String            @db.Uuid
  organizationId String?           @db.Uuid
  type           PlatformEventType
  reason         String?
  payload        Json              @default("{}")
  createdAt      DateTime          @default(now())

  admin        PlatformAdmin @relation(fields: [adminUserId], references: [userId], onDelete: NoAction)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction)

  @@index([organizationId, createdAt])
}
