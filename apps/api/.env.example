# Database
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# Server
PORT=4000
NODE_ENV=development
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:5173

# Auth (Better Auth, wired in Phase 2). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000

# Email (SMTP; Mailpit in local docker compose, UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Sentinel <no-reply@sentinel.local>"

# Legacy local disk storage, removed when S3 lands in Phase 2
STORAGE_PATH=./uploads
