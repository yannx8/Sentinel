# Copy to .env for local development.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel?schema=public
NODE_ENV=development
PORT=4000
# Public URL of the web app, used in email links and for CORS.
WEB_ORIGIN=http://localhost:5173
# Set to true behind a reverse proxy (nginx in docker compose).
TRUST_PROXY=false
# "lax" for same-origin deploys. Use "none" only when web and API are on different sites (requires HTTPS).
SESSION_COOKIE_SAMESITE=lax
# SMTP. Leave SMTP_HOST empty to print emails to the API log instead.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM="Sentinel <no-reply@sentinel.local>"
# Uploaded photos.
STORAGE_PATH=./uploads
