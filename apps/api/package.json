{
  "name": "@sentinel/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/create-platform-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@sentinel/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^9.9.0",
    "prisma": "~7.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
