# Sentinel API: bundled with tsup, runtime dependencies installed with pnpm deploy.
FROM node:24-alpine AS base
WORKDIR /repo
# Optional extra root certificates for machines behind TLS inspection (see .certs/README.md).
COPY .certs/ /tmp/certs/
RUN cat /etc/ssl/certs/ca-certificates.crt /tmp/certs/*.pem > /tmp/ca-bundle.crt 2>/dev/null || cp /etc/ssl/certs/ca-certificates.crt /tmp/ca-bundle.crt
ENV NODE_EXTRA_CA_CERTS=/tmp/ca-bundle.crt
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile --filter @sentinel/api...
RUN pnpm --filter @sentinel/api db:generate && pnpm --filter @sentinel/api build
RUN pnpm --filter @sentinel/api deploy --prod --legacy /out && cp -r apps/api/dist /out/dist

FROM node:24-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
RUN mkdir -p /app/uploads && chown node:node /app/uploads
USER node
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1:4000/health || exit 1
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/server.js"]
