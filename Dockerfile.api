FROM node:22-alpine AS base
WORKDIR /repo
COPY .certs/ /tmp/certs/
RUN cat /etc/ssl/certs/ca-certificates.crt /tmp/certs/*.pem > /tmp/ca-bundle.crt 2>/dev/null || cp /etc/ssl/certs/ca-certificates.crt /tmp/ca-bundle.crt
ENV NODE_EXTRA_CA_CERTS=/tmp/ca-bundle.crt
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile --network-concurrency=4 --fetch-retries=5 --filter @sentinel/api...
RUN pnpm --filter @sentinel/api prisma:generate && pnpm --filter @sentinel/api build
RUN pnpm --filter @sentinel/api deploy --prod --legacy /out
RUN cd /out && npx prisma generate

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 4000
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/server.js"]
