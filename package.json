{
  "name": "sentinel",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @sentinel/api --filter @sentinel/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sentinel/api db:generate",
    "db:migrate": "pnpm --filter @sentinel/api db:migrate",
    "db:reset": "pnpm --filter @sentinel/api db:reset",
    "db:seed": "pnpm --filter @sentinel/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
