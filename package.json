{
  "name": "sentinel",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @sentinel/api --filter @sentinel/web dev",
    "dev:mobile": "pnpm --filter @sentinel/mobile start",
    "build": "pnpm --filter @sentinel/api --filter @sentinel/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @sentinel/api test",
    "db:generate": "pnpm --filter @sentinel/api prisma:generate",
    "db:migrate": "pnpm --filter @sentinel/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @sentinel/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @sentinel/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
